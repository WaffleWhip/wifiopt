# wifiopt-api env. Copy to .env and fill in. NEVER commit .env.
PORT=3000
WIFIPT_OUT=/root/wifiopt/out
WIFIPT_BIN=/root/wifiopt/target/release/wifiopt

MYSQL_HOST=192.168.41.115
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=wifi_optimization

# internal daily run (no system cron)
SCHEDULE_HOUR=20
SCHEDULE_MINUTE=0
SCHEDULE_STALE=50
SCHEDULE_UPLOAD=false
SCHEDULE_BRUTEFORCE=false

# optional: overrides MYSQL_* for the optimizer child
# DATABASE_URL=mysql://USER:PASS@192.168.41.115:3306/wifi_optimization
